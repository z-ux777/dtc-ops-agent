# Everything runs offline by default. Fill these only if you want live calls.
DTC_OFFLINE=1                    # set to 0 to allow live LLM calls
OPENROUTER_API_KEY=              # optional: OpenRouter key for nicer reply wording
OPENROUTER_MODEL=openai/gpt-4o-mini
DTC_API_TOKEN=                   # optional: require X-API-Token header on the HTTP API
# Klaviyo / Slack keys are placeholders inside the disabled n8n nodes. Never commit real keys.
